# === DeepSeek API ===
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 三接口配置 ===
NOVELIST_MODEL=deepseek-v4-flash
NOVELIST_TEMPERATURE=1.5
NOVELIST_MAX_TOKENS=6000
NOVELIST_TOP_P=1.0
NOVELIST_FREQUENCY_PENALTY=0.3
NOVELIST_PRESENCE_PENALTY=0.2
NOVELIST_ENABLE_THINKING=false
NOVELIST_REASONING_EFFORT=medium

EXTRACTOR_MODEL=deepseek-v4-flash
EXTRACTOR_TEMPERATURE=0.3
EXTRACTOR_MAX_TOKENS=3000
EXTRACTOR_TOP_P=1.0
EXTRACTOR_FREQUENCY_PENALTY=0
EXTRACTOR_PRESENCE_PENALTY=0
EXTRACTOR_ENABLE_THINKING=false
EXTRACTOR_REASONING_EFFORT=low

COMPRESSOR_MODEL=deepseek-v4-flash
COMPRESSOR_TEMPERATURE=0.3
COMPRESSOR_MAX_TOKENS=3000
COMPRESSOR_TOP_P=1.0
COMPRESSOR_FREQUENCY_PENALTY=0
COMPRESSOR_PRESENCE_PENALTY=0
COMPRESSOR_ENABLE_THINKING=false
COMPRESSOR_REASONING_EFFORT=low

# === 写作参数 ===
CHAPTER_WORD_COUNT_MIN=2200
CHAPTER_WORD_COUNT_MAX=2800
CONTEXT_SOFT_LIMIT_TOKENS=30000
RECENT_CHAPTERS_COUNT=2

# === 语速节拍检测 ===
RHYTHM_MAX_CONSECUTIVE_HIGH_TENSION=4
RHYTHM_HIGH_TENSION_THRESHOLD=7
RHYTHM_MAX_CONSECUTIVE_SAME_SCENE_TYPE=3

# === 多小说 ===
NOVELNEXUS_ACTIVE_NOVEL=default
